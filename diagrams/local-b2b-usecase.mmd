graph TB
    %% Actors (outside the system)
    Guest[👤 Guest/Visitor]
    Seller[👤 Seller]
    Retailer[👤 Retailer] 
    Admin[👤 Admin]
    PaymentService[🏦 Payment Service]
    SMSService[📱 SMS Service]
    EmailService[📧 Email Service]
    
    %% System boundary
    subgraph "<<Subsystem>> Local B2B Platform"
        %% Authentication subsystem
        subgraph "<<Service>> Authentication"
            UC1[Register Account]
            UC2[Login]
            UC3[Logout]
            UC4[Update Profile]
        end
        
        %% Product Management subsystem
        subgraph "<<Service>> Product Management"
            UC5[Browse Products]
            UC6[Search Products]
            UC7[View Product Details]
            UC8[List New Product]
            UC9[Edit Product]
            UC10[Delete Product]
            UC11[Manage Categories]
        end
        
        %% Order Management subsystem
        subgraph "<<Service>> Order Management"
            UC12[Add to Cart]
            UC13[View Cart]
            UC14[Place Order]
            UC15[Process Payment]
            UC16[Track Order]
            UC17[Update Order Status]
            UC18[Generate Invoice]
        end
        
        %% Analytics subsystem
        subgraph "<<Service>> Analytics & Reports"
            UC19[View Sales Dashboard]
            UC20[Generate Sales Report]
            UC21[View Analytics Charts]
            UC22[Export PDF Report]
        end
        
        %% Admin Management subsystem
        subgraph "<<Service>> Administration"
            UC23[Manage Users]
            UC24[View Platform Stats]
            UC25[Activate/Deactivate Users]
            UC26[Monitor Activities]
        end
        
        %% Communication subsystem
        subgraph "<<Service>> Communication"
            UC27[Contact Supplier]
            UC28[Send Notifications]
            UC29[View Contact Info]
        end
    end
    
